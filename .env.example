# ==============================================
# AMABA Backend — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# HuggingFace (required for orchestration / InferenceClientModel)
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Orchestration
ORCHESTRATION_MAX_STEPS=15
ORCHESTRATION_TIMEOUT=300
